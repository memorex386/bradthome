{
  "name": "bradthome",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "husky && node scripts/setup-local.ts",
    "test": "vitest run --exclude tests/001/integration/install.test.ts --exclude tests/001/integration/setup-check.test.ts --exclude tests/002/integration/setup-check-repo.test.ts --exclude tests/002/integration/ruleset-check.test.ts --exclude tests/003/integration/setup-check-docker.test.ts",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc",
    "terms": "node scripts/terms.ts",
    "lock": "node scripts/lock-tests.ts",
    "trace": "node scripts/trace.ts",
    "sync": "node scripts/sync.ts",
    "setup:check": "node scripts/setup-check.ts",
    "review:eval": "node scripts/review-eval.ts",
    "guard:install": "node scripts/guard-install.ts",
    "cost-guard:deploy": "node scripts/cost-guard/deploy.ts",
    "chat-api:deploy": "node scripts/chat-api/deploy.ts",
    "content:export": "node scripts/content/export.ts",
    "ruleset:check": "node scripts/ruleset-check.ts",
    "release:status": "node scripts/release/status.ts",
    "release:check": "node scripts/release/check.ts",
    "release:rollback": "node scripts/release/rollback.ts",
    "lint": "node scripts/ci/site-report.ts lint",
    "format": "prettier --write apps/site scripts",
    "format:check": "node scripts/ci/site-report.ts format",
    "site:types": "node scripts/ci/site-report.ts astro-check",
    "site:build": "pnpm --filter @bradthome/site build",
    "site:html": "node scripts/ci/site-report.ts html",
    "site:links": "node scripts/ci/site-report.ts links --offline --include-fragments --root-dir apps/site/dist",
    "site:lighthouse": "node scripts/ci/site-report.ts lighthouse",
    "site:pdf": "node scripts/ci/site-report.ts pdf",
    "csp": "node scripts/site/csp.ts",
    "printer:install": "node scripts/site/printer.ts",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/site/visual.ts",
    "mutation": "stryker run",
    "test:setup": "vitest run tests/001/integration/install.test.ts tests/001/integration/setup-check.test.ts tests/002/integration/setup-check-repo.test.ts tests/002/integration/ruleset-check.test.ts tests/003/integration/setup-check-docker.test.ts",
    "previews:refresh": "node scripts/previews/refresh.ts",
    "evals": "vitest run --config vitest.evals.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/format": "21.2.3",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "firebase-tools": "15.34.2",
    "html-validate": "11.18.0",
    "husky": "9.1.7",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
