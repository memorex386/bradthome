---
// The role switch (spec 009's FR-005). Each role is its own page (slice 3.6),
// so each choice is a link, and the page you're on is marked with
// aria-current. It works with no script, keeps the back button, and can be
// shared. The quiet look is one line of plain links, quieter than buttons,
// which the home and role pages show under the hero (spec 025, D206). The
// switch never shows the page's URL beside it, since the browser does.
interface Props {
  roles: readonly { label: string; href: string; current?: boolean }[]
  label?: string
  /** The quiet look: a muted label, borderless links, the current one with a soft fill. */
  quiet?: boolean
  /** The label's id, unique on the page when a page shows more than one switch. */
  id?: string
  /** A name for the region in place of the label, when a page shows the switch more than once. */
  name?: string
  demo?: { index: number; state: 'hover' | 'focus' }
}

const { roles, label = 'Hiring for', quiet = false, id = 'roles-label', name, demo } = Astro.props
---

<nav class:list={['ds-roles', quiet && 'ds-roles--quiet']} aria-labelledby={name ? undefined : id} aria-label={name}>
  <span class="ds-roles__label" id={id}>
    {label}
    {quiet && <span aria-hidden="true">:</span>}
  </span>
  <ul class="ds-roles__list">
    {roles.map((role, index) => (
      <li>
        <a
          class:list={['ds-roles__item', demo?.index === index && `is-${demo.state}`]}
          href={role.href}
          aria-current={role.current ? 'page' : undefined}
        >
          {role.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
