---
import Icon from './Icon.astro'
import { COPY, EMAIL, MAILTO } from './contact.ts'

// Brad's address, the one contact component (spec 017). Every place that
// offers contact uses it, so the address, its link and its copy button work
// the same everywhere.
//
// - "quiet": the address as a mail link, in a row of quiet links (the hero).
// - Otherwise: the address large, as a mail link, with a Copy button.
//   email.client.ts, inside the site's one module (D147, D154), copies it with
//   the Clipboard API and says so in a polite live region. Where the clipboard
//   is refused it selects the address instead. With no script the button is
//   hidden by the scripting media query, and the link and the selectable text
//   still work. The label's three words share one grid cell, so a change never
//   moves the layout.
//
// "demo" holds a state still for the design system's gallery.
interface Props {
  quiet?: boolean
  class?: string
  demo?: 'focus' | 'copied' | 'selected'
}

const { quiet, class: className, demo } = Astro.props
const state = demo === 'copied' || demo === 'selected' ? demo : 'rest'
---

{quiet ? (
  <a class:list={['ds-link', 'ds-link--quiet', 'ds-email-link', className]} href={MAILTO}>
    {EMAIL}
  </a>
) : (
  <div class:list={['ds-email', className]} data-email data-state={state} data-demo={demo}>
    <a class="ds-email__address" href={MAILTO} data-email-address>
      {EMAIL}
    </a>
    <button
      type="button"
      class:list={['ds-button', 'ds-button--secondary', 'ds-email__copy', demo === 'focus' && 'is-focus']}
      data-email-copy
    >
      <Icon name="copy" />
      <span class="ds-email__labels">
        <span class="ds-email__label" data-label="rest">
          {COPY.rest}
        </span>
        <span class="ds-email__label" data-label="copied">
          {COPY.copied}
        </span>
        <span class="ds-email__label" data-label="selected">
          {COPY.selected}
        </span>
      </span>
    </button>
    <span class="ds-visually-hidden" role="status" data-email-status>
      {state === 'copied' ? COPY.copiedNote : state === 'selected' ? COPY.selectedNote : ''}
    </span>
  </div>
)}
