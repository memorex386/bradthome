---
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import { GITHUB, LINKEDIN } from './profiles.ts'
import PreviewLink from '../previews/PreviewLink.astro'

// The design system's header (spec 009's FR-003). On a desktop: Brad's name,
// the page's sections, Brad's GitHub and LinkedIn, and the résumé. On a phone
// the sections fold into a menu, a native disclosure, so it needs no script.
// Each page passes its own sections and résumé link.
//
// Spec 036: GitHub and LinkedIn are their logos, drawn inline, and the résumé
// is a button with a PDF tag, and all three stay in the bar on a phone too,
// beside the menu, at 44 px each, so they're always one tap away. Each logo
// keeps its preview card (spec 016).
//
// The home and role pages pass `sticky` (spec 027, D209): the header stays at
// the top, condenses once the page scrolls, takes the band's colors over
// Hopper, and marks the section being read with a rule under its link. The
// sticky look is CSS; header.client.ts, in the one module, only sets the
// header's data-stuck and data-band and the links' aria-current, from
// IntersectionObservers, never a scroll handler.
interface Link {
  label: string
  href: string
  current?: boolean
}

interface Props {
  sections: readonly Link[]
  resume?: { label: string; href: string }
  sticky?: boolean
}

const { sections, resume, sticky = false } = Astro.props
---

{sticky && <span class="ds-header-mark" aria-hidden="true" />}
<header class:list={['ds-header', sticky && 'ds-header--sticky']} data-sticky={sticky ? '' : undefined}>
  <div class="ds-header__in ds-wrap">
    <a class="ds-header__name" href="/">
      Brad Thome
    </a>
    <nav class="ds-header__nav ds-header__sections" aria-label="Sections">
      <ul>
        {sections.map((link) => (
          <li>
            <a class="ds-nav-link" href={link.href} aria-current={link.current ? 'location' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {sticky && <span class="ds-header__rule" aria-hidden="true" />}
    </nav>
    <div class="ds-header__end">
      <nav aria-label="Elsewhere" class="ds-header__profiles">
        <ul>
          <li>
            <PreviewLink class="ds-button ds-button--icon ds-header__icon" href={GITHUB.href} place="header" label={GITHUB.label}>
              <Logo name="github" />
            </PreviewLink>
          </li>
          <li>
            <PreviewLink
              class="ds-button ds-button--icon ds-header__icon ds-header__icon--linkedin"
              href={LINKEDIN.href}
              place="header"
              label={LINKEDIN.label}
            >
              <Logo name="linkedin" />
            </PreviewLink>
          </li>
        </ul>
      </nav>
      {resume && (
        <a class="ds-button ds-button--secondary ds-header__resume" href={resume.href} type="application/pdf">
          <Icon name="doc" />
          <span class="ds-header__resume-label">{resume.label}</span> <span class="ds-header__tag">PDF</span>
        </a>
      )}
      <details class="ds-header__menu">
        <summary class="ds-button ds-button--icon" aria-label="Menu">
          <Icon name="menu" class="icon-open" />
          <Icon name="close" class="icon-close" />
        </summary>
        <nav class="ds-header__menu-panel" aria-label="Menu">
          <ul>
            {sections.map((link) => (
              <li>
                <a class="ds-nav-link" href={link.href} aria-current={link.current ? 'location' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
