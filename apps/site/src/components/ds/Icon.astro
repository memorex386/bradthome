---
// The design system's line icons, 24×24 strokes in the text's color. Each is
// decoration beside a word or inside a labelled control, so it's hidden from
// assistive technology.
interface Props {
  name: 'arrow' | 'download' | 'menu' | 'close' | 'sparkle' | 'chevron' | 'copy'
  class?: string
}

const PATHS: Record<Props['name'], string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  sparkle: 'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z',
  chevron: 'M6 9l6 6 6-6',
  copy: 'M8 8h12v12H8zM16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3',
}

const { name, class: className } = Astro.props
---

<svg
  class:list={['ds-icon', className]}
  width="18"
  height="18"
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={PATHS[name]}></path>
</svg>
