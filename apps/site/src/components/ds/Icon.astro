---
// The design system's line icons, 24×24 strokes in the text's color. Each is
// decoration beside a word or inside a labelled control, so it's hidden from
// assistive technology. Spec 036 adds the hero's: a down arrow, a document, a
// letter, a phone, a stack, a chevron pointing on, and a link out.
interface Props {
  name:
    | 'arrow'
    | 'download'
    | 'menu'
    | 'close'
    | 'sparkle'
    | 'chevron'
    | 'copy'
    | 'check'
    | 'down'
    | 'doc'
    | 'mail'
    | 'phone'
    | 'stack'
    | 'next'
    | 'external'
  class?: string
}

const PATHS: Record<Props['name'], string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  sparkle: 'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z',
  chevron: 'M6 9l6 6 6-6',
  copy: 'M8 8h12v12H8zM16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  down: 'M12 5v14M6 13l6 6 6-6',
  doc: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h4',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  phone: 'M8 2.5h8a1.5 1.5 0 0 1 1.5 1.5v16a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20V4A1.5 1.5 0 0 1 8 2.5zM11 18.5h2',
  stack: 'M12 3l9 5-9 5-9-5zM3 12.5l9 5 9-5M3 17l9 5 9-5',
  next: 'M9 6l6 6-6 6',
  external: 'M14 5h5v5M19 5l-8 8M18 14v5H5V6h5',
}

const { name, class: className } = Astro.props
---

<svg
  class:list={['ds-icon', className]}
  width="18"
  height="18"
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={PATHS[name]} pathLength={name === 'check' ? 1 : undefined}></path>
</svg>
