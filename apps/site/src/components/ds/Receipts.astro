---
import Icon from './Icon.astro'
import PreviewLink from '../previews/PreviewLink.astro'
import { askOf, askQuestionOf, hostOf, questionOf, RECEIPTS, type ReceiptEntry, rowIdOf, summaryOf } from './receipts.ts'

// A card's receipts, gathered in one drawer (spec 026, D208, amending spec
// 009's FR-006). The claims keep their numbered markers in line; this is the
// card's one Receipts control, beside its tags (the "tags" slot) or alone. It's
// a native disclosure, so it opens with a click, a tap, Enter or Space, and
// needs no script. A marker links to its row, and a browser opens a closed
// disclosure when a link targets what's inside it; the row then tints for a
// moment, in CSS. Each row shows its number, its title, and its source's host
// as a link, or "Ask me" when there's no public link. "Ask me", and the
// drawer's ask link, open Ask about Brad with a question from the claim in
// its box, for the visitor to send (spec 030, D213); with no script, or
// before the chat can open, they go to the contact section.
interface Props {
  items: readonly ReceiptEntry[]
  /** Where the card's work happened, for the drawer's ask question. */
  place?: string
  /** Where "Ask me" goes with no script. */
  askHref?: string
  open?: boolean
  demo?: 'hover' | 'focus'
}

const { items, place = 'Brad', askHref = RECEIPTS.askHref, open, demo } = Astro.props
if (items.length === 0) throw new Error('A receipts drawer needs at least one receipt.')
const hasTags = Astro.slots.has('tags')
const summary = summaryOf(items)
const ask = askOf(items)
---

<div class:list={['ds-receipts', !hasTags && 'ds-receipts--alone']}>
  {hasTags && <slot name="tags" />}
  <details class="ds-receipts__drawer" open={open}>
    <summary class:list={['ds-receipts__summary', demo && `is-${demo}`]}>
      <span class="ds-receipts__numbers" aria-hidden="true">
        {items.map((item) => (
          <span class:list={['ds-marker', item.kind === 'ask' && 'ds-marker--ask']}>{item.n}</span>
        ))}
      </span>
      <span class="ds-receipts__label">{RECEIPTS.label}</span> <span class="ds-receipts__sum">{summary}</span>
      <Icon name="chevron" class="ds-receipts__chevron" />
    </summary>
    <div class="ds-receipts__body">
      <ol class="ds-receipts__list">
        {items.map((item) => (
          <li class:list={['ds-receipts__row', `ds-receipts__row--${item.kind}`]} id={rowIdOf(item.id)} value={item.n}>
            <span class:list={['ds-marker', item.kind === 'ask' && 'ds-marker--ask']} aria-hidden="true">
              {item.n}
            </span>
            <span class="ds-receipts__title">
              <span class="sr-only">Receipt {item.n}: </span>
              {item.title}
            </span>{' '}
            {item.kind === 'proof' ? (
              <div class="ds-receipts__sources">
                {item.evidence.map((href) => (
                  <PreviewLink class="ds-receipts__source" href={href} place={item.id}>
                    {hostOf(href)}
                  </PreviewLink>
                ))}
              </div>
            ) : (
              <a
                class="ds-receipts__kind ds-receipts__ask"
                href={askHref}
                data-chat-ask={questionOf(item)}
                aria-label={`${RECEIPTS.ask} about receipt ${item.n}`}
              >
                {RECEIPTS.ask}
              </a>
            )}
          </li>
        ))}
      </ol>
      {ask && (
        <p class="ds-receipts__foot">
          <a class="ds-link" href={askHref} data-chat-ask={askQuestionOf(items, place)}>
            {ask}
          </a>
        </p>
      )}
    </div>
  </details>
</div>
