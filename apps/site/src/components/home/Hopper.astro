---
import { getCollection, getEntry } from 'astro:content'
import Chips from '../ds/Chips.astro'
import Eyebrow from '../ds/Eyebrow.astro'
import HopperClaim from './HopperClaim.astro'
import Receipts from '../ds/Receipts.astro'
import { eyebrowOf, HEADING, storyOf } from './hopper.ts'
import { topicOrderOf } from './roles.ts'
import type { Role } from './hero.ts'
import '../../styles/home/hopper.css'

// The Hopper story on the new home page (spec 011): the role and dates, then
// the work grouped by topic, each claim with its numbered marker, and each
// card's receipts in one drawer beside its tags (spec 026, D208).
// The words are the public claims about Hopper, as written (D129); the
// content schema has already refused any claim that isn't public. It reads in
// order with no motion, and ships no script. A role page passes its role, which
// puts its topics first (spec 014, D134).
interface Props {
  role?: Role
}

const { role = 'all' } = Astro.props

const job = await getEntry('jobs', 'hopper')
if (!job) throw new Error('The Hopper story needs content/jobs/hopper.yaml.')
const claims = await getCollection('claims', (entry) => entry.data.subject === 'hopper')
const story = storyOf(
  claims.map((entry) => ({ id: entry.id, ...entry.data })),
  topicOrderOf(role),
)
// Each topic keeps its place in the claims' order as a key, so a role switch
// can move it to its new place (spec 029's MA-15).
const keys = storyOf(claims.map((entry) => ({ id: entry.id, ...entry.data }))).topics.map((topic) => topic.slug)
const keyOf = (slug: string): string => `hopper__topic--k${keys.indexOf(slug) + 1}`
if (story.role.length === 0 || story.topics.length === 0) throw new Error('The Hopper story needs public claims about Hopper.')
---

<section id="hopper" class="ds-band hopper" aria-labelledby="hopper-heading">
  <div class="ds-wrap hopper__inner">
    <header class="hopper__head" data-reveal="head">
      <Eyebrow>{eyebrowOf(job.data)}</Eyebrow>
      <h2 id="hopper-heading" class="ds-heading">
        {HEADING}
      </h2>
      <div class="ds-claims hopper__role">
        {story.role.map((item) => (
          <HopperClaim item={item} class="hopper__lede" />
        ))}
      </div>
      <Receipts items={story.role} />
    </header>

    <ol class="hopper__topics" aria-label="The work, by topic">
      {story.topics.map((topic, index) => (
        <li class:list={['ds-card', 'hopper__topic', keyOf(topic.slug), index === 0 && 'ds-card--highlight']} data-reveal="card">
          {topic.kicker && <span class="ds-card__kicker">{topic.kicker}</span>}
          <h3 id={`hopper-${topic.slug}`} class="ds-subheading hopper__title">
            {topic.title}
          </h3>
          <div class="ds-claims">
            {topic.items.map((item) => (
              <HopperClaim item={item} />
            ))}
          </div>
          <Receipts items={topic.items}>
            {topic.tags.length > 0 && <Chips slot="tags" items={topic.tags} variant="tag" label={`${topic.title}, tags`} />}
          </Receipts>
        </li>
      ))}
    </ol>

    {story.quotes.length > 0 && (
      <div class="hopper__quotes">
        {story.quotes.map((item) => (
          <figure class="hopper__quote">
            <blockquote>
              <HopperClaim item={item} class="hopper__quote-text" />
            </blockquote>
          </figure>
        ))}
        <Receipts items={story.quotes} />
      </div>
    )}
  </div>
</section>
