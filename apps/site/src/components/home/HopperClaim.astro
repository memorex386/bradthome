---
import ReceiptMarker from '../ds/ReceiptMarker.astro'
import type { Item } from './hopper.ts'

// One claim of the Hopper story with its receipt's marker (spec 011, spec
// 009's FR-006). Its card gathers the receipts in one drawer (spec 026, D208).
interface Props {
  item: Item
  class?: string
}

const { item, class: className } = Astro.props
---

<p class:list={['ds-body', className]} data-claim={item.id}>
  {item.text}
  <ReceiptMarker n={item.n} kind={item.kind} for={item.id} />
</p>
