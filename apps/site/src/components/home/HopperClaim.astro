---
import ClaimText from '../ds/ClaimText.astro'
import { anchorOf } from '../ds/proof.ts'
import type { Item } from './hopper.ts'

// One claim of the Hopper story, or of an Experience card (spec 011, spec
// 038). It carries the anchor its receipt had, so a chat source still lands
// on it and tints it for a moment (D229), and it ends with the sparkle that
// asks Ask about Brad about it (D230).
interface Props {
  item: Item
  class?: string
}

const { item, class: className } = Astro.props
---

<p class:list={['ds-body', 'ds-claim', className]} id={anchorOf(item.id)} data-claim={item.id}>
  <ClaimText text={item.text} words={item.text} title={item.title} />
</p>
