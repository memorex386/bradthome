---
import ClaimText from '../ds/ClaimText.astro'
import { anchorOf } from '../ds/proof.ts'
import type { Item } from './hopper.ts'
import { blocksOf } from './side.ts'

// One claim of a side project (spec 013), like HopperClaim, but a claim
// written as a lead and a list shows as a paragraph and a list. It carries
// the anchor its receipt had (D229), and its sparkle ends the claim's last
// block (spec 038, D230).
interface Props {
  item: Item
}

const { item } = Astro.props
const blocks = blocksOf(item.text)
const lastIndex = blocks.length - 1
---

<div class="side__claim ds-claim" id={anchorOf(item.id)} data-claim={item.id}>
  {blocks.map((block, index) =>
    block.kind === 'p' ? (
      <p class="ds-body">{index === lastIndex ? <ClaimText text={block.text} words={item.text} title={item.title} /> : block.text}</p>
    ) : (
      <ul class="ds-body side__list">
        {block.items.map((text, at) => (
          <li>
            {index === lastIndex && at === block.items.length - 1 ? <ClaimText text={text} words={item.text} title={item.title} /> : text}
          </li>
        ))}
      </ul>
    ),
  )}
</div>
