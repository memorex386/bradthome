---
import ReceiptMarker from '../ds/ReceiptMarker.astro'
import type { Item } from './hopper.ts'
import { blocksOf } from './side.ts'

// One claim of a side project with its receipt's marker (spec 013), like spec
// 011's HopperClaim, but a claim written as a lead and a list shows as a
// paragraph and a list. The marker ends the claim's last block. Its card
// gathers the receipts in one drawer (spec 026, D208).
interface Props {
  item: Item
}

const { item } = Astro.props
const blocks = blocksOf(item.text)
const lastIndex = blocks.length - 1
---

<div class="side__claim" data-claim={item.id}>
  {blocks.map((block, index) =>
    block.kind === 'p' ? (
      <p class="ds-body">
        {block.text}
        {index === lastIndex && <ReceiptMarker n={item.n} kind={item.kind} for={item.id} />}
      </p>
    ) : (
      <ul class="ds-body side__list">
        {block.items.map((text, at) => (
          <li>
            {text}
            {index === lastIndex && at === block.items.length - 1 && <ReceiptMarker n={item.n} kind={item.kind} for={item.id} />}
          </li>
        ))}
      </ul>
    ),
  )}
</div>
