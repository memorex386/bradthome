---
import Footer from '../ds/Footer.astro'
import Header from '../ds/Header.astro'
import DesignBase from '../../layouts/DesignBase.astro'
import Contact from './Contact.astro'
import Experience from './Experience.astro'
import Hero from './Hero.astro'
import Hopper from './Hopper.astro'
import Side from './Side.astro'
import type { Role } from './hero.ts'
import { canonicalOf, PAGES } from './roles.ts'
import '../../styles/home/morph.css'

// The new home page, whole: /v2 shows it for every role, and /mobile,
// /fullstack and /ai each show it for one (spec 014, D6). The same words and
// facts show on every page; a role page names its role in the hero, lights
// its word and rows, and puts its Hopper topics first (D134). The role switch
// links every role page from under the hero's buttons (spec 025, D206), so it
// works with no script and keeps the back button. Only the home is indexable (D135): each role page
// carries noindex and a canonical link to itself. The contact section closes
// every page, and the header's "Contact" links to it (spec 017, D152). The
// header stays at the top and marks the section being read, and the footer
// links the public repo (spec 027, D209 and D210).
interface Props {
  role: Role
}

const { role } = Astro.props

const sections = [
  { label: 'Hopper', href: '#hopper' },
  { label: 'Experience', href: '#experience' },
  { label: 'On the side', href: '#side' },
  { label: 'Contact', href: '#contact' },
]
const description =
  'Brad Thome, a senior mobile and full-stack engineer in Dallas–Fort Worth, builds Android, iOS and web products end to end.'
const title = role === 'all' ? 'Brad Thome' : PAGES[role].title
---

<DesignBase title={title} description={description} noindex={role !== 'all'} canonical={canonicalOf(role)}>
  <a class="ds-skip" href="#main">
    Skip to the content
  </a>
  <Header sections={sections} sticky />

  <main id="main">
    <Hero role={role} />

    <Hopper role={role} />

    <Experience />

    <Side />

    <Contact role={role} />
  </main>

  <Footer built />
</DesignBase>
