---
import { getCollection } from 'astro:content'
import Eyebrow from '../ds/Eyebrow.astro'
import Stats from '../ds/Stats.astro'
import { cardsOf as experienceCardsOf, type ExperienceJob } from './experience.ts'
import { storyOf } from './hopper.ts'
import { CASE_STUDY, cardsOf, COUNTED, EYEBROW, HEADING, hostOf, SOURCE, type SideProject } from './side.ts'
import { dateLabelOf, RECORDS, recordsOf, REPO } from './record.ts'
import PreviewLink from '../previews/PreviewLink.astro'
import SideClaim from './SideClaim.astro'
import Receipts from '../ds/Receipts.astro'
import '../../styles/home/side.css'

// The "On the side" section on the new home page (spec 013): VINDecoded's
// card, then Sudoku World's small card, as their project files' `display`
// asks, then bradthome.com's small card (spec 033). VINDecoded is a side
// project that does well, never the headline (D132). Every sentence is a
// public claim, as written, or comes from a project file, and each claim
// carries its receipt, numbered on from the Experience section's.
// bradthome.com's card counts the repo's records as the page is built, and
// dates them by the build; each count links its records. It has no motion of
// its own, and ships no script.

const projects: SideProject[] = (await getCollection('projects')).map((entry) => ({ id: entry.id, ...entry.data }))
if (projects.length === 0) throw new Error('The side projects section needs content/projects.')
const claims = (await getCollection('claims')).map((entry) => ({ id: entry.id, ...entry.data }))
const jobs: ExperienceJob[] = (await getCollection('jobs')).map((entry) => ({ id: entry.id, ...entry.data }))

// The receipts number on from the Hopper story's and the Experience section's, so each number is used once on the page.
const hopper = storyOf(claims.filter((claim) => claim.subject === 'hopper'))
const hopperCount = hopper.role.length + hopper.topics.reduce((sum, topic) => sum + topic.items.length, 0) + hopper.quotes.length
const experience = experienceCardsOf(jobs, claims, hopperCount + 1)
const experienceCount = [...experience.featured, ...experience.cards].reduce((sum, card) => sum + card.items.length, 0)
const cards = cardsOf(projects, claims, hopperCount + experienceCount + 1)
// Counted once per page, from the checkout the build runs in (spec 033, D48).
const records = cards.some(({ look }) => look.records) ? recordsOf(process.cwd(), new Date()) : undefined
---

<section id="side" class="side" aria-labelledby="side-heading">
  <div class="ds-wrap side__inner">
    <header class="side__head" data-reveal="head">
      <Eyebrow>{EYEBROW}</Eyebrow>
      <h2 id="side-heading" class="ds-heading">
        {HEADING}
      </h2>
    </header>

    {cards.map(({ project, look, kicker, items }) => (
      <article
        id={`side-${project.id}`}
        class:list={['ds-card', 'side__card', `side__card--${project.display}`]}
        aria-labelledby={`side-${project.id}-heading`}
        data-reveal="card"
      >
        <div class="side__card-top">
          <div class="side__card-head">
            {look.badge === 'grid' ? (
              <span class="side__badge side__badge--grid" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <path d="M9 3v18M15 3v18M3 9h18M3 15h18" />
                </svg>
              </span>
            ) : look.badge === 'code' ? (
              <span class="side__badge side__badge--grid" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M8.5 7.5 4 12l4.5 4.5M15.5 7.5 20 12l-4.5 4.5M13.75 5.5l-3.5 13" />
                </svg>
              </span>
            ) : (
              <span class="side__badge" aria-hidden="true">
                {look.badge.letters}
              </span>
            )}
            <div class="side__card-name">
              <h3 id={`side-${project.id}-heading`} class="ds-subheading side__card-title">
                {project.name}
              </h3>
              <span class="ds-card__kicker side__kicker">{kicker}</span>
            </div>
          </div>
          {look.stats && <Stats items={look.stats} />}
          {look.records && records && (
            <div class="side__records">
              <ul class="side__counts">
                {RECORDS.map((record) => (
                  <li>
                    <a class="side__count" href={record.href}>
                      <span class="side__count-value" data-record={record.kind}>
                        {records.counts[record.kind]}
                      </span>{' '}
                      <span class="side__count-label">{record.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="side__counted">
                {COUNTED.before}
                <time datetime={records.counted} data-record="counted">
                  {dateLabelOf(records.counted)}
                </time>
                {COUNTED.after}
              </p>
            </div>
          )}
        </div>
        <div class="ds-claims">
          {items.map((item) => (
            <SideClaim item={item} />
          ))}
        </div>
        <Receipts items={items} place={project.name} />
        <p class="side__links">
          {look.source ? (
            <a class="ds-link" href={REPO}>
              {SOURCE}
            </a>
          ) : (
            <PreviewLink class="ds-link" href={project.url} place={`side-${project.id}`}>
              {hostOf(project.url)}
            </PreviewLink>
          )}
          {look.caseStudy && (
            <a class="ds-link" href={CASE_STUDY.href}>
              {CASE_STUDY.label}
            </a>
          )}
        </p>
      </article>
    ))}
  </div>
</section>
