---
import type { GetStaticPaths } from 'astro'
import HomePage from '../components/home/HomePage.astro'
import { ROLES, type RolePage } from '../components/home/roles.ts'

// The role pages, /mobile, /fullstack and /ai (spec 014): the new home page
// reordered for one kind of role, with the same words and facts (D6, D134).
// They go live with v2.0 (spec 019),
// and each carries noindex, so only the home is indexable (D135).
export const getStaticPaths = (() => ROLES.map((role) => ({ params: { role } }))) satisfies GetStaticPaths

const role = Astro.params.role as RolePage
---

<HomePage role={role} />
