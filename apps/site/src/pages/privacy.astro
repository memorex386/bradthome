---
import Footer from '../components/ds/Footer.astro'
import Header from '../components/ds/Header.astro'
import DesignBase from '../layouts/DesignBase.astro'
import { DESCRIPTION, LEDE, QUESTIONS, SECTIONS, TITLE, UPDATED } from '../components/privacy/privacy.ts'
import '../styles/privacy.css'

// The privacy note (spec 018's Story 5): what the new pages measure, with
// Umami Cloud, in plain words. Every phase 3 footer links here. Like every
// phase 3 page it carries noindex until v2.0, and a release build leaves it
// out (D127). The header loads the site's one module, so this page's own
// view is counted the same way.
const sections = [
  { label: 'Hopper', href: '/v2#hopper' },
  { label: 'Experience', href: '/v2#experience' },
  { label: 'On the side', href: '/v2#side' },
  { label: 'Contact', href: '/v2#contact' },
]
const updated = new Date(`${UPDATED}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<DesignBase title={`${TITLE} · Brad Thome`} description={DESCRIPTION}>
  <a class="ds-skip" href="#main">
    Skip to the content
  </a>
  <Header sections={sections} />

  <main id="main" class="ds-wrap privacy">
    <h1 class="ds-title privacy__title">{TITLE}</h1>
    <p class="ds-small privacy__updated">
      Updated <time datetime={UPDATED}>{updated}</time>
    </p>
    <p class="ds-lede privacy__lede">{LEDE}</p>

    {SECTIONS.map((section) => (
      <section class="privacy__section" aria-labelledby={`privacy-${section.id}`}>
        <h2 id={`privacy-${section.id}`} class="ds-subheading">
          {section.heading}
        </h2>
        {section.paragraphs?.map((paragraph) => (
          <p class="ds-body">{paragraph}</p>
        ))}
        {section.items && (
          <ul class="ds-body privacy__list">
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <p class="ds-body privacy__questions">
      {QUESTIONS.lead}{' '}
      <a class="ds-link" href={QUESTIONS.href}>
        {QUESTIONS.email}
      </a>
      .
    </p>
  </main>

  <Footer>No cookies.</Footer>
</DesignBase>
