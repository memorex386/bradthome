---
import Footer from '../components/ds/Footer.astro'
import Header from '../components/ds/Header.astro'
import Hero from '../components/home/Hero.astro'
import Hopper from '../components/home/Hopper.astro'
import DesignBase from '../layouts/DesignBase.astro'

// The redesigned home page as it's built, slice by slice (D127). It shows on
// pull request previews and the next channel, which serve every page with a
// noindex header, and a release build leaves it out, so live keeps v1's home
// until v2.0. Nothing links here. Slice 3.2 built the hero, and slice 3.3 the
// Hopper story its first button points at (D128, D129).
const description =
  'Brad Thome, a senior mobile and full-stack engineer in Dallas–Fort Worth, builds Android, iOS and web products end to end.'
---

<DesignBase title="Brad Thome" description={description} noindex={false}>
  <a class="ds-skip" href="#main">
    Skip to the content
  </a>
  <Header sections={[{ label: 'Hopper', href: '#hopper' }]} />

  <main id="main">
    <Hero />

    <Hopper />
  </main>

  <Footer>The redesign, in progress.</Footer>
</DesignBase>
