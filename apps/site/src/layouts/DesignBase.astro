---
import { Font } from 'astro:assets'
import '../styles/ds/tokens.css'
import '../styles/ds/components.css'

// The design system's layout (spec 009's FR-008). It's apart from Base.astro,
// so v1's pages load none of the design system until slices 3.2–3.5 move
// each one here (D119). Until the v2.0 release every page on it is unlinked
// and carries noindex (D118), so the prop defaults to on.
interface Props {
  title: string
  description: string
  noindex?: boolean
}

const { title, description, noindex = true } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>
  <body class="ds">
    <slot />
  </body>
</html>
