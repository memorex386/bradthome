---
import { Font } from 'astro:assets'
import '../styles/ds/tokens.css'
import '../styles/ds/components.css'

// The design system's layout (spec 009's FR-008), apart from Base.astro, which
// the essay and the 404 page keep (D121). Every page on it carries noindex
// unless it says otherwise; only the home is indexable (D135, spec 019).
// A page with a canonical URL also gets the link-preview tags v1's home had,
// so a shared link still shows its title and description.
interface Props {
  title: string
  description: string
  noindex?: boolean
  /** The page's canonical URL, when it sets one (spec 014). */
  canonical?: string
}

const { title, description, noindex = true, canonical } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && (
      <>
        <meta name="author" content="Brad Thome" />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Brad Thome" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>
  <body class="ds">
    <slot />
  </body>
</html>
