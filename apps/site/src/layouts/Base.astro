---
import { Font } from 'astro:assets'
import '../styles/tokens.css'
import '../styles/site.css'
// After the stylesheets, so their place among this layout's imports, which orders each page's styles, stays as it was.
import { shareImageOf } from '../components/share/data.ts'

interface Props {
  title: string
  description: string
  /** The link-preview tags, for the pages people share. The 404 page has none. */
  share?: { type: 'website' | 'article'; title: string }
}

const { title, description, share } = Astro.props
// Pages build to page.html and Hosting serves them at /page, so drop the extension.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site)
// A shared page's card: its own, as the essay has, or the home's (spec 039, D232).
const image = shareImageOf(canonical.pathname)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    {share && (
      <>
        <meta name="author" content="Brad Thome" />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content={share.type} />
        <meta property="og:site_name" content="Brad Thome" />
        <meta property="og:title" content={share.title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image.url} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={image.url} />
        <meta name="twitter:image:alt" content={image.alt} />
      </>
    )}
    <Font cssVariable="--font-charis" preload />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="bg-page font-text text-ink">
    <header class="site-header">
      <a class="name" href="/">
        Brad Thome
      </a>
      <nav aria-label="Elsewhere">
        <a href="https://github.com/memorex386">GitHub</a>
        <a href="https://www.linkedin.com/in/brad-thome/">LinkedIn</a>
      </nav>
    </header>
    <main class="frame">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/">Brad Thome</a> · Dallas–Fort Worth
    </footer>
  </body>
</html>
