---
import { Font } from 'astro:assets'
import '../styles/tokens.css'

interface Props {
  title: string
  description: string
  /** How main is laid out: centred for the short pages, a text column for an essay. */
  frame?: 'center' | 'essay'
}

const { title, description, frame = 'center' } = Astro.props
const frames = {
  center: 'mx-auto flex min-h-dvh max-w-2xl flex-col justify-center gap-4 px-6 py-16',
  essay: 'essay-frame',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-charis" preload />
    <Font cssVariable="--font-inter" preload />
    <slot name="head" />
  </head>
  <body class="bg-page font-text text-ink">
    <slot name="header" />
    <main class={frames[frame]}>
      <slot />
    </main>
  </body>
</html>
